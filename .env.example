# =============================================================================
# RECKAI Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Clerk Authentication (Production Identity Provider)
# -----------------------------------------------------------------------------
# Public publishable key (safe for client-side bundle)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_RECKAI_PUBLISHABLE_KEY

# Private secret key (NEVER expose to client code or commit to source control)
CLERK_SECRET_KEY=sk_test_RECKAI_SECRET_KEY

# Clerk Route Redirection Rules
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/admin/sign-in

# -----------------------------------------------------------------------------
# 2. Database & Storage Configuration
# -----------------------------------------------------------------------------
# Optional PostgreSQL connection URI (falls back to memory repository if absent)
# DATABASE_URL=postgresql://user:password@localhost:5432/reckai

# -----------------------------------------------------------------------------
# 3. Optional Communication & Telemetry Hooks
# -----------------------------------------------------------------------------
# Optional email dispatch service key (e.g., Resend, Postmark)
# EMAIL_SERVICE_KEY=re_123456789

# Optional third-party privacy analytics measurement ID (e.g., Plausible)
# NEXT_PUBLIC_ANALYTICS_ID=reckai.com
